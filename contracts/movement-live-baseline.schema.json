{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfect-assassin.local/contracts/movement-live-baseline.schema.json",
  "title": "Movement live baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "baseline_id",
    "scope",
    "review_state",
    "execution_authority",
    "artifacts",
    "promotion_requirements"
  ],
  "properties": {
    "record_type": {"const": "movement_live_baseline"},
    "schema_version": {"const": "1.0"},
    "baseline_id": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "review_state": {"const": "OPERATOR_REVIEWED_REFERENCE"},
    "execution_authority": {"const": false},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "bytes", "sha256"],
        "properties": {
          "role": {"enum": ["LIVE_RESULT", "REVIEW_VIDEO"]},
          "path": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "expected_status": {"type": "string", "minLength": 1},
          "expected_control_frames": {"type": "integer", "minimum": 0},
          "expected_recovery_attempts": {"type": "integer", "minimum": 0}
        }
      }
    },
    "promotion_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_filmed_crypt_exits",
        "require_no_blockage",
        "require_no_regression_against_reference",
        "require_operator_review"
      ],
      "properties": {
        "minimum_filmed_crypt_exits": {"const": 10},
        "require_no_blockage": {"const": true},
        "require_no_regression_against_reference": {"const": true},
        "require_operator_review": {"const": true}
      }
    }
  }
}
