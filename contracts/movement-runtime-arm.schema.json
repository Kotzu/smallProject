{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfect-assassin.local/contracts/movement-runtime-arm.schema.json",
  "title": "Perfect Assassin single-pulse movement runtime arm v0.1",
  "type": "object",
  "required": [
    "record_type", "schema_version", "arm_nonce", "authorization_id",
    "authorization_sha256", "session_receipt", "target_profile",
    "target_instance_id", "actor_binding", "pid", "hwnd",
    "process_created_at_utc", "process_creation_filetime_utc",
    "windows_session_id", "window_title", "window_class", "client_build",
    "build_signature", "executable_path", "executable_sha256",
    "environment_scope", "server_kind", "expected_realm_fingerprint",
    "realm_routing_sha256", "realmlist_relative_path", "realmlist_sha256",
    "realmlist_directive", "realm_revalidation", "allowed_modes",
    "allowed_capabilities", "allowed_controls", "max_hold_duration_ms",
    "max_execution_envelope_ms", "max_primitives", "manual_takeover_required",
    "release_all_required", "combat_authorized", "economy_authorized",
    "clock_id", "issued_at_monotonic_ms", "expires_at_monotonic_ms",
    "issued_at", "expires_at", "active", "scope", "execution_authority"
  ],
  "properties": {
    "record_type": { "const": "movement_runtime_arm" },
    "schema_version": { "const": "0.1" },
    "arm_nonce": { "$ref": "#/$defs/uuid" },
    "authorization_id": { "$ref": "#/$defs/identifier" },
    "authorization_sha256": { "$ref": "#/$defs/sha256" },
    "session_receipt": {
      "type": "object",
      "required": [
        "record_type", "schema_version", "receipt_nonce", "receipt_sha256",
        "execution_authority"
      ],
      "properties": {
        "record_type": { "const": "lab_client_launch_receipt" },
        "schema_version": { "const": "1.0" },
        "receipt_nonce": { "$ref": "#/$defs/uuid" },
        "receipt_sha256": { "$ref": "#/$defs/sha256" },
        "execution_authority": { "const": false }
      },
      "additionalProperties": false
    },
    "target_profile": { "const": "tbc_243_lab" },
    "target_instance_id": { "$ref": "#/$defs/identifier" },
    "actor_binding": { "$ref": "#/$defs/actorBinding" },
    "pid": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "hwnd": { "type": "string", "pattern": "^0x[A-F0-9]+$" },
    "process_created_at_utc": {
      "type": "string", "format": "date-time", "pattern": "Z$"
    },
    "process_creation_filetime_utc": {
      "type": "string", "pattern": "^[0-9]{17,20}$"
    },
    "windows_session_id": {
      "type": "integer", "minimum": 0, "maximum": 4294967295
    },
    "window_title": { "const": "World of Warcraft" },
    "window_class": { "const": "GxWindowClassD3d" },
    "client_build": { "type": "string", "minLength": 1, "maxLength": 64 },
    "build_signature": { "type": "string", "minLength": 1, "maxLength": 256 },
    "executable_path": { "type": "string", "minLength": 3, "maxLength": 32767 },
    "executable_sha256": { "$ref": "#/$defs/sha256" },
    "environment_scope": { "const": "emulator_local" },
    "server_kind": { "const": "emulator" },
    "expected_realm_fingerprint": {
      "type": "string", "minLength": 1, "maxLength": 256
    },
    "realm_routing_sha256": { "$ref": "#/$defs/sha256" },
    "realmlist_relative_path": {
      "type": "string", "minLength": 1, "maxLength": 260
    },
    "realmlist_sha256": { "$ref": "#/$defs/sha256" },
    "realmlist_directive": { "const": "set realmlist 127.0.0.1" },
    "realm_revalidation": {
      "type": "object",
      "required": [
        "record_type", "schema_version", "issuer_id", "revalidation_nonce",
        "receipt_sha256", "execution_authority"
      ],
      "properties": {
        "record_type": { "const": "local_realm_revalidation_receipt" },
        "schema_version": { "const": "0.1" },
        "issuer_id": { "const": "perfect_assassin.local_realm_revalidator" },
        "revalidation_nonce": { "$ref": "#/$defs/uuid" },
        "receipt_sha256": { "$ref": "#/$defs/sha256" },
        "execution_authority": { "const": false }
      },
      "additionalProperties": false
    },
    "allowed_modes": {
      "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true,
      "items": { "const": "MOVEMENT_ONLY" }
    },
    "allowed_capabilities": {
      "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true,
      "items": { "const": "MOVEMENT_EXECUTION" }
    },
    "allowed_controls": {
      "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true,
      "items": { "const": "MOVE_FORWARD" }
    },
    "max_hold_duration_ms": { "const": 100 },
    "max_execution_envelope_ms": { "const": 150 },
    "max_primitives": { "const": 1 },
    "manual_takeover_required": { "const": true },
    "release_all_required": { "const": true },
    "combat_authorized": { "const": false },
    "economy_authorized": { "const": false },
    "clock_id": { "$ref": "#/$defs/identifier" },
    "issued_at_monotonic_ms": { "type": "number", "minimum": 0 },
    "expires_at_monotonic_ms": { "type": "number", "exclusiveMinimum": 0 },
    "issued_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "expires_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "active": { "const": true },
    "scope": { "const": "lab_movement_single_pulse" },
    "execution_authority": { "const": true }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{8}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{12}$"
    },
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "actorBinding": {
      "type": "object",
      "required": [
        "schema_version", "instance_id", "actor_role", "actor_id",
        "decision_context", "memory_namespace", "expected_character_name",
        "credential_alias", "binding_assurance"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "instance_id": { "$ref": "#/$defs/identifier" },
        "actor_role": { "const": "lab_clone" },
        "actor_id": { "$ref": "#/$defs/identifier" },
        "decision_context": { "const": "lab_clone" },
        "memory_namespace": { "type": "string", "pattern": "^memory:lab:" },
        "expected_character_name": { "const": "Predator" },
        "credential_alias": { "const": "credential:lab:pa_observer" },
        "binding_assurance": {
          "type": "object",
          "required": ["state", "evidence_refs"],
          "properties": {
            "state": { "const": "configured_expected_only" },
            "evidence_refs": {
              "type": "array", "minItems": 1, "maxItems": 4,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 256 }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
