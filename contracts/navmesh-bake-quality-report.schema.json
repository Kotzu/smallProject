{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfect-assassin.local/contracts/navmesh-bake-quality-report.schema.json",
  "title": "Perfect Assassin navmesh bake quality report v1",
  "$defs": {
    "count": { "type": "integer", "minimum": 0, "maximum": 16777216 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "coordinate": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 0, "maximum": 63 },
        { "type": "integer", "minimum": 0, "maximum": 63 }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "nav_tile": {
      "type": "object",
      "required": ["grid_x", "grid_y", "artifact", "byte_size", "sha256"],
      "properties": {
        "grid_x": { "type": "integer", "minimum": 0, "maximum": 63 },
        "grid_y": { "type": "integer", "minimum": 0, "maximum": 63 },
        "artifact": { "type": "string", "pattern": "^[0-9]{2}_[0-9]{2}\\.nav$" },
        "byte_size": { "type": "integer", "minimum": 1, "maximum": 1099511627776 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "record_type", "schema_version", "status", "catalog_id",
    "client_build", "map_id", "internal_name", "expected_adt_count",
    "nav_adt_count", "finished_adt_count", "missing_coordinates",
    "extra_coordinates", "invalid_nav_artifact_count", "diagnostics",
    "nav_tiles", "nav_tiles_sha256", "terminal_return_code", "log_sha256", "geometric_validation_required",
    "execution_authority"
  ],
  "properties": {
    "record_type": { "const": "navmesh_bake_quality_report" },
    "schema_version": { "const": "1.0" },
    "status": {
      "enum": [
        "IN_PROGRESS", "FAILED", "COMPLETE_CLEAN",
        "COMPLETE_WITH_RECAST_DIAGNOSTICS"
      ]
    },
    "catalog_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "client_build": { "type": "string", "minLength": 1, "maxLength": 32 },
    "map_id": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "internal_name": { "type": "string", "minLength": 1, "maxLength": 96 },
    "expected_adt_count": { "$ref": "#/$defs/count" },
    "nav_adt_count": { "$ref": "#/$defs/count" },
    "finished_adt_count": { "$ref": "#/$defs/count" },
    "missing_coordinates": {
      "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/coordinate" }
    },
    "extra_coordinates": {
      "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/coordinate" }
    },
    "invalid_nav_artifact_count": { "$ref": "#/$defs/count" },
    "nav_tiles": {
      "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/nav_tile" }
    },
    "nav_tiles_sha256": { "$ref": "#/$defs/sha256" },
    "diagnostics": {
      "type": "object",
      "required": [
        "recast_error_count", "recast_warning_count",
        "multiple_outline_error_count", "bad_outline_error_count",
        "bad_triangulation_warning_count", "walk_center_warning_count",
        "dangling_face_warning_count", "failed_tile_count"
      ],
      "properties": {
        "recast_error_count": { "$ref": "#/$defs/count" },
        "recast_warning_count": { "$ref": "#/$defs/count" },
        "multiple_outline_error_count": { "$ref": "#/$defs/count" },
        "bad_outline_error_count": { "$ref": "#/$defs/count" },
        "bad_triangulation_warning_count": { "$ref": "#/$defs/count" },
        "walk_center_warning_count": { "$ref": "#/$defs/count" },
        "dangling_face_warning_count": { "$ref": "#/$defs/count" },
        "failed_tile_count": { "$ref": "#/$defs/count" }
      },
      "additionalProperties": false
    },
    "terminal_return_code": {
      "anyOf": [{ "type": "null" }, { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 }]
    },
    "log_sha256": { "$ref": "#/$defs/sha256" },
    "geometric_validation_required": { "const": true },
    "execution_authority": { "const": false }
  },
  "additionalProperties": false
}
