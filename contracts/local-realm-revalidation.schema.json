{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfect-assassin.local/contracts/local-realm-revalidation.schema.json",
  "title": "Perfect Assassin local realm revalidation v0.1",
  "type": "object",
  "required": [
    "record_type", "schema_version", "issuer_id", "revalidation_nonce",
    "authorization_id", "authorization_sha256", "session_receipt_nonce",
    "session_receipt_sha256", "target_profile", "actor_id",
    "actor_instance_id", "pid", "hwnd", "process_created_at_utc",
    "process_creation_filetime_utc", "windows_session_id", "executable_path",
    "executable_sha256", "environment_scope", "server_kind",
    "expected_realm_fingerprint", "realm_routing_sha256",
    "realmlist_relative_path", "realmlist_sha256", "realmlist_directive",
    "method", "observed_at", "expires_at", "scope", "execution_authority"
  ],
  "properties": {
    "record_type": { "const": "local_realm_revalidation_receipt" },
    "schema_version": { "const": "0.1" },
    "issuer_id": { "const": "perfect_assassin.local_realm_revalidator" },
    "revalidation_nonce": { "$ref": "#/$defs/uuid" },
    "authorization_id": { "$ref": "#/$defs/identifier" },
    "authorization_sha256": { "$ref": "#/$defs/sha256" },
    "session_receipt_nonce": { "$ref": "#/$defs/uuid" },
    "session_receipt_sha256": { "$ref": "#/$defs/sha256" },
    "target_profile": { "const": "tbc_243_lab" },
    "actor_id": { "$ref": "#/$defs/identifier" },
    "actor_instance_id": { "$ref": "#/$defs/identifier" },
    "pid": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "hwnd": { "type": "string", "pattern": "^0x[A-F0-9]+$" },
    "process_created_at_utc": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "process_creation_filetime_utc": { "type": "string", "pattern": "^[0-9]{17,20}$" },
    "windows_session_id": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "executable_path": { "type": "string", "minLength": 3, "maxLength": 32767 },
    "executable_sha256": { "$ref": "#/$defs/sha256" },
    "environment_scope": { "const": "emulator_local" },
    "server_kind": { "const": "emulator" },
    "expected_realm_fingerprint": { "type": "string", "minLength": 1, "maxLength": 256 },
    "realm_routing_sha256": { "$ref": "#/$defs/sha256" },
    "realmlist_relative_path": { "type": "string", "minLength": 1, "maxLength": 260 },
    "realmlist_sha256": { "$ref": "#/$defs/sha256" },
    "realmlist_directive": { "const": "set realmlist 127.0.0.1" },
    "method": { "const": "exact_realmlist_listener_process_config_and_realm_route" },
    "observed_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "expires_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "scope": { "const": "lab_evaluation_only" },
    "execution_authority": { "const": false }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
    "uuid": { "type": "string", "pattern": "^[A-Fa-f0-9]{8}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{12}$" },
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" }
  },
  "additionalProperties": false
}
