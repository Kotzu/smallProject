{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfect-assassin.local/contracts/navmesh-geometry-validation-report.schema.json",
  "title": "Perfect Assassin navmesh geometry validation report v1",
  "$defs": {
    "count": { "type": "integer", "minimum": 0, "maximum": 4096 },
    "inner_count": { "type": "integer", "minimum": 0, "maximum": 1048576 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "failure": {
      "type": "object",
      "required": ["artifact", "code"],
      "properties": {
        "artifact": { "type": "string", "pattern": "^[0-9]{2}_[0-9]{2}\\.nav$" },
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,95}$" }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "record_type", "schema_version", "status", "validator_id",
    "catalog_id", "catalog_sha256", "client_build", "map_id",
    "internal_name", "expected_tile_count", "validated_tile_count",
    "expected_inner_tile_count", "validated_inner_tile_count",
    "detour_tile_count", "empty_inner_tile_count",
    "failure_count", "failures", "nav_tiles_sha256", "execution_authority"
  ],
  "properties": {
    "record_type": { "const": "navmesh_geometry_validation_report" },
    "schema_version": { "const": "1.0" },
    "status": { "enum": ["PASS", "FAIL"] },
    "validator_id": { "const": "perfect-assassin.namigator-detour-v7-structural-v2" },
    "catalog_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "catalog_sha256": { "$ref": "#/$defs/sha256" },
    "client_build": { "type": "string", "minLength": 1, "maxLength": 32 },
    "map_id": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "internal_name": { "type": "string", "minLength": 1, "maxLength": 96 },
    "expected_tile_count": { "$ref": "#/$defs/count" },
    "validated_tile_count": { "$ref": "#/$defs/count" },
    "expected_inner_tile_count": { "$ref": "#/$defs/inner_count" },
    "validated_inner_tile_count": { "$ref": "#/$defs/inner_count" },
    "detour_tile_count": { "$ref": "#/$defs/inner_count" },
    "empty_inner_tile_count": { "$ref": "#/$defs/inner_count" },
    "failure_count": { "$ref": "#/$defs/count" },
    "failures": {
      "type": "array", "maxItems": 4096,
      "items": { "$ref": "#/$defs/failure" }
    },
    "nav_tiles_sha256": { "$ref": "#/$defs/sha256" },
    "execution_authority": { "const": false }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "PASS" } } },
      "then": {
        "properties": {
          "failure_count": { "const": 0 },
          "failures": { "maxItems": 0 }
        }
      }
    }
  ],
  "additionalProperties": false
}
