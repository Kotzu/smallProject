{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfect-assassin.local/contracts/combat-runtime-arm.schema.json",
  "title": "Perfect Assassin controlled LAB combat runtime arm v0.1",
  "type": "object",
  "required": [
    "record_type", "schema_version", "arm_nonce", "authorization_id",
    "authorization_sha256", "authorization_semantic_sha256",
    "session_authorization_sha256", "session_receipt_nonce",
    "session_receipt_sha256", "realm_revalidation_nonce",
    "realm_revalidation_sha256", "target_profile", "actor_id",
    "actor_instance_id", "pid", "hwnd", "process_created_at_utc",
    "process_creation_filetime_utc", "windows_session_id", "window_title",
    "window_class", "client_build", "build_signature", "executable_path",
    "executable_sha256", "expected_realm_fingerprint",
    "realm_routing_sha256", "realmlist_sha256", "policy", "clock_id",
    "issued_at_monotonic_ms", "expires_at_monotonic_ms", "issued_at",
    "expires_at", "active", "scope", "execution_authority"
  ],
  "properties": {
    "record_type": { "const": "combat_runtime_arm" },
    "schema_version": { "const": "0.1" },
    "arm_nonce": { "$ref": "#/$defs/uuid" },
    "authorization_id": { "const": "execution:tbc243-lab:combat-f4a-bounded" },
    "authorization_sha256": { "$ref": "#/$defs/sha256" },
    "authorization_semantic_sha256": { "$ref": "#/$defs/sha256" },
    "session_authorization_sha256": { "$ref": "#/$defs/sha256" },
    "session_receipt_nonce": { "$ref": "#/$defs/uuid" },
    "session_receipt_sha256": { "$ref": "#/$defs/sha256" },
    "realm_revalidation_nonce": { "$ref": "#/$defs/uuid" },
    "realm_revalidation_sha256": { "$ref": "#/$defs/sha256" },
    "target_profile": { "const": "tbc_243_lab" },
    "actor_id": { "$ref": "#/$defs/identifier" },
    "actor_instance_id": { "$ref": "#/$defs/identifier" },
    "pid": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "hwnd": { "type": "string", "pattern": "^0x[A-F0-9]+$" },
    "process_created_at_utc": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "process_creation_filetime_utc": { "type": "string", "pattern": "^[0-9]{17,20}$" },
    "windows_session_id": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "window_title": { "const": "World of Warcraft" },
    "window_class": { "const": "GxWindowClassD3d" },
    "client_build": { "const": "2.4.3.8606" },
    "build_signature": { "type": "string", "minLength": 1, "maxLength": 256 },
    "executable_path": { "type": "string", "minLength": 3, "maxLength": 32767 },
    "executable_sha256": { "$ref": "#/$defs/sha256" },
    "expected_realm_fingerprint": { "type": "string", "minLength": 1, "maxLength": 256 },
    "realm_routing_sha256": { "$ref": "#/$defs/sha256" },
    "realmlist_sha256": { "$ref": "#/$defs/sha256" },
    "policy": { "$ref": "#/$defs/combatPolicy" },
    "clock_id": { "$ref": "#/$defs/identifier" },
    "issued_at_monotonic_ms": { "type": "number", "minimum": 0 },
    "expires_at_monotonic_ms": { "type": "number", "exclusiveMinimum": 0 },
    "issued_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "expires_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "active": { "const": true },
    "scope": { "const": "lab_controlled_combat" },
    "execution_authority": { "const": true }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
    "uuid": { "type": "string", "pattern": "^[A-Fa-f0-9]{8}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{12}$" },
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "combatPolicy": {
      "type": "object",
      "required": [
        "allowed_controls", "max_actions", "max_encounter_seconds",
        "max_acquisition_seconds", "max_combat_seconds", "max_recovery_seconds",
        "max_approach_pulses", "approach_hold_duration_ms", "orbit_hold_duration_ms",
        "max_turn_pulses", "max_facing_turn_pulses", "search_turn_hold_duration_ms",
        "search_turn_mouse_delta_x", "turn_near_hold_duration_ms",
        "turn_near_mouse_delta_x", "turn_medium_hold_duration_ms",
        "turn_medium_mouse_delta_x", "turn_far_hold_duration_ms",
        "turn_far_mouse_delta_x", "turn_medium_offset_threshold",
        "turn_far_offset_threshold", "turn_execution_slack_ms",
        "action_key_hold_ms", "max_target_level_delta", "retreat_health_pct",
        "manual_takeover_required", "release_all_required",
        "player_targets_authorized", "economy_authorized"
      ],
      "properties": {
        "allowed_controls": {
          "type": "array", "minItems": 13, "maxItems": 13, "uniqueItems": true,
          "prefixItems": [
            { "const": "TARGET_VISIBLE_HOSTILE" },
            { "const": "TARGET_NEAREST_HOSTILE" }, { "const": "TARGET_EXACT_NAME" },
            { "const": "TARGET_LAST_HOSTILE" }, { "const": "INTERACT_TARGET" },
            { "const": "ACTION_SLOT_1" },
            { "const": "ACTION_SLOT_2" }, { "const": "ACTION_SLOT_3" },
            { "const": "MOVE_FORWARD" }, { "const": "STRAFE_LEFT" },
            { "const": "STRAFE_RIGHT" }, { "const": "TURN_LEFT" },
            { "const": "TURN_RIGHT" }
          ],
          "items": false
        },
        "max_actions": { "const": 64 },
        "max_encounter_seconds": { "const": 90 },
        "max_acquisition_seconds": { "const": 25 },
        "max_combat_seconds": { "const": 60 },
        "max_recovery_seconds": { "const": 5 },
        "max_approach_pulses": { "const": 10 },
        "approach_hold_duration_ms": { "const": 250 },
        "orbit_hold_duration_ms": { "const": 90 },
        "max_turn_pulses": { "const": 12 },
        "max_facing_turn_pulses": { "const": 24 },
        "search_turn_hold_duration_ms": { "const": 200 },
        "search_turn_mouse_delta_x": { "const": 24 },
        "turn_near_hold_duration_ms": { "const": 25 },
        "turn_near_mouse_delta_x": { "const": 4 },
        "turn_medium_hold_duration_ms": { "const": 35 },
        "turn_medium_mouse_delta_x": { "const": 14 },
        "turn_far_hold_duration_ms": { "const": 50 },
        "turn_far_mouse_delta_x": { "const": 28 },
        "turn_medium_offset_threshold": { "const": 0.25 },
        "turn_far_offset_threshold": { "const": 0.60 },
        "turn_execution_slack_ms": { "const": 150 },
        "action_key_hold_ms": { "const": 25 },
        "max_target_level_delta": { "const": 1 },
        "retreat_health_pct": { "const": 25 },
        "manual_takeover_required": { "const": true },
        "release_all_required": { "const": true },
        "player_targets_authorized": { "const": false },
        "economy_authorized": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
