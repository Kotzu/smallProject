{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfect-assassin.local/contracts/zygor-npcdata-map-discovery.schema.json",
  "title": "Zygor NPCData map-area discovery v1",
  "type": "object",
  "required": [
    "record_type", "schema_version", "source_reference", "source_sha256",
    "source_size_bytes", "provider_version", "client_version", "client_build",
    "map_area_count", "map_areas", "execution_authority"
  ],
  "properties": {
    "record_type": { "const": "zygor_npcdata_map_discovery" },
    "schema_version": { "const": "1.0" },
    "source_reference": { "type": "string", "minLength": 1, "maxLength": 512 },
    "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_size_bytes": { "type": "integer", "minimum": 1 },
    "provider_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "client_version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "client_build": { "type": "string", "minLength": 1, "maxLength": 32 },
    "map_area_count": { "type": "integer", "minimum": 1 },
    "map_areas": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["map_id", "row_count"],
        "properties": {
          "map_id": { "type": "integer", "minimum": 0 },
          "row_count": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "execution_authority": { "const": false }
  },
  "additionalProperties": false
}
