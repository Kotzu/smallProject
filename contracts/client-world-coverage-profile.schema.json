{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfect-assassin.local/contracts/client-world-coverage-profile.schema.json",
  "title": "Perfect Assassin reviewed client world coverage profile v1",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "map": {
      "type": "object",
      "required": [
        "map_id", "internal_name", "classification", "coverage_state",
        "interior_coverage", "road_semantic_coverage"
      ],
      "properties": {
        "map_id": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "internal_name": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_ '-]{0,95}$" },
        "classification": {
          "enum": ["continent", "instance", "battleground", "arena", "transport", "other"]
        },
        "coverage_state": { "enum": ["partial", "complete"] },
        "interior_coverage": { "enum": ["none", "partial", "complete"] },
        "road_semantic_coverage": { "enum": ["partial", "complete"] }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "record_type", "schema_version", "catalog_id", "target_profile",
    "product", "expansion", "client_version", "client_build",
    "asset_container", "asset_parser_profile", "world_catalog_asset",
    "nav_profile_id", "maps", "execution_authority"
  ],
  "properties": {
    "record_type": { "const": "client_world_coverage_profile" },
    "schema_version": { "const": "1.0" },
    "catalog_id": { "$ref": "#/$defs/identifier" },
    "target_profile": { "$ref": "#/$defs/identifier" },
    "product": { "$ref": "#/$defs/identifier" },
    "expansion": { "$ref": "#/$defs/identifier" },
    "client_version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "client_build": { "type": "string", "minLength": 1, "maxLength": 32 },
    "asset_container": { "enum": ["mpq", "casc"] },
    "asset_parser_profile": { "$ref": "#/$defs/identifier" },
    "world_catalog_asset": { "type": "string", "minLength": 1, "maxLength": 256 },
    "nav_profile_id": { "$ref": "#/$defs/identifier" },
    "maps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/map" }
    },
    "execution_authority": { "const": false }
  },
  "additionalProperties": false
}
