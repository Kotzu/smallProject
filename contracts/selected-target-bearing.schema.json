{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfect-assassin.local/contracts/selected-target-bearing.schema.json",
  "title": "Selected target visual bearing observation v1.0",
  "type": "object",
  "required": [
    "record_type", "schema_version", "observation_id", "frame_id",
    "combat_observation_id", "combat_observation_sha256", "target_identity_crc16",
    "target_profile", "actor_binding", "authorization_sha256", "client_build",
    "build_signature", "tracking_state", "reason", "detection_method",
    "direction", "offset_x_normalized", "center_x_px", "center_y_px",
    "frame_center_x_px", "frame_height_px",
    "confidence", "timing", "provenance", "execution_authority"
  ],
  "properties": {
    "record_type": { "const": "selected_target_bearing_observation" },
    "schema_version": { "const": "1.0" },
    "observation_id": { "$ref": "#/$defs/identifier" },
    "frame_id": { "$ref": "#/$defs/identifier" },
    "combat_observation_id": { "$ref": "#/$defs/identifier" },
    "combat_observation_sha256": { "$ref": "#/$defs/sha256" },
    "target_identity_crc16": {
      "oneOf": [
        { "type": "null" },
        { "type": "integer", "minimum": 1, "maximum": 65535 }
      ]
    },
    "target_profile": { "$ref": "#/$defs/identifier" },
    "actor_binding": { "$ref": "#/$defs/actor_binding" },
    "authorization_sha256": { "$ref": "#/$defs/sha256" },
    "client_build": { "type": "string", "minLength": 1, "maxLength": 128 },
    "build_signature": { "type": "string", "minLength": 1, "maxLength": 256 },
    "tracking_state": { "enum": ["VISIBLE", "LOST", "AMBIGUOUS"] },
    "reason": { "type": "string", "minLength": 1, "maxLength": 128 },
    "detection_method": {
      "oneOf": [
        { "type": "null" },
        { "enum": ["selection_circle", "distant_selection_arc", "selection_circle_nameplate_fusion"] }
      ]
    },
    "direction": {
      "oneOf": [
        { "type": "null" },
        { "enum": ["LEFT", "CENTER", "RIGHT"] }
      ]
    },
    "offset_x_normalized": {
      "oneOf": [
        { "type": "null" },
        { "type": "number", "minimum": -1, "maximum": 1 }
      ]
    },
    "center_x_px": {
      "oneOf": [
        { "type": "null" },
        { "type": "number", "minimum": 0, "maximum": 32768 }
      ]
    },
    "center_y_px": {
      "oneOf": [
        { "type": "null" },
        { "type": "number", "minimum": 0, "maximum": 32768 }
      ]
    },
    "frame_center_x_px": { "type": "number", "exclusiveMinimum": 0, "maximum": 32768 },
    "frame_height_px": { "type": "number", "exclusiveMinimum": 0, "maximum": 32768 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "timing": { "$ref": "#/$defs/timing" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "execution_authority": { "const": false }
  },
  "allOf": [
    {
      "if": {
        "properties": { "tracking_state": { "const": "VISIBLE" } },
        "required": ["tracking_state"]
      },
      "then": {
        "properties": {
          "target_identity_crc16": { "type": "integer" },
          "detection_method": { "type": "string" },
          "direction": { "type": "string" },
          "offset_x_normalized": { "type": "number" },
          "center_x_px": { "type": "number" },
          "center_y_px": { "type": "number" },
          "confidence": { "exclusiveMinimum": 0 }
        }
      },
      "else": {
        "properties": {
          "detection_method": { "type": "null" },
          "direction": { "type": "null" },
          "offset_x_normalized": { "type": "null" },
          "center_x_px": { "type": "null" },
          "center_y_px": { "type": "null" },
          "confidence": { "const": 0 }
        }
      }
    }
  ],
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 160 },
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "actor_binding": {
      "type": "object",
      "required": [
        "schema_version", "instance_id", "actor_role", "actor_id",
        "decision_context", "memory_namespace", "expected_character_name",
        "credential_alias", "binding_assurance"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "instance_id": { "$ref": "#/$defs/identifier" },
        "actor_role": { "enum": ["champion_journey", "lab_clone"] },
        "actor_id": { "$ref": "#/$defs/identifier" },
        "decision_context": { "enum": ["champion", "lab_clone"] },
        "memory_namespace": { "$ref": "#/$defs/identifier" },
        "expected_character_name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "credential_alias": { "type": "string", "minLength": 1, "maxLength": 128 },
        "binding_assurance": {
          "type": "object",
          "required": ["state", "evidence_refs"],
          "properties": {
            "state": { "const": "configured_expected_only" },
            "evidence_refs": {
              "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 256 }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "timing": {
      "type": "object",
      "required": [
        "captured_at", "monotonic_timestamp_s", "frame_age_ms",
        "observed_monotonic_s", "age_at_observation_ms", "freshness_limit_ms",
        "expires_monotonic_s"
      ],
      "properties": {
        "captured_at": { "type": "string", "format": "date-time" },
        "monotonic_timestamp_s": { "type": "number", "minimum": 0 },
        "frame_age_ms": { "type": "number", "minimum": 0 },
        "observed_monotonic_s": { "type": "number", "minimum": 0 },
        "age_at_observation_ms": { "type": "number", "minimum": 0 },
        "freshness_limit_ms": { "const": 450 },
        "expires_monotonic_s": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "origin", "capture_origin", "capability", "scope", "profile_id",
        "profile_version", "profile_sha256", "calibration_state", "evidence_refs"
      ],
      "properties": {
        "origin": { "const": "visible_selected_target_indicator" },
        "capture_origin": { "enum": ["window_capture", "replay_fixture"] },
        "capability": { "const": "selected_target_visual_bearing_read_only" },
        "scope": { "enum": ["synthetic_fixture", "lab_evaluation_only", "unpromoted_evaluation_only"] },
        "profile_id": { "const": "selected_target_bearing_tbc243_v1" },
        "profile_version": { "const": "0.9.0" },
        "profile_sha256": { "$ref": "#/$defs/sha256" },
        "calibration_state": { "const": "controlled_live_lab_verified" },
        "evidence_refs": {
          "type": "array", "minItems": 2, "maxItems": 16, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
