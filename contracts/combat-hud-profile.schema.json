{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfect-assassin.local/contracts/combat-hud-profile.schema.json",
  "title": "Visible combat HUD detector profile v1.0",
  "type": "object",
  "required": [
    "profile", "profile_version", "target_profile", "client_build",
    "protocol_version", "magic", "grid_columns", "grid_rows", "cell_pitch_px",
    "fiducial_dx_px", "fiducial_dy_px", "first_cell_dx_px", "first_cell_dy_px",
    "search_height_fraction", "search_width_fraction", "marker_high_threshold",
    "marker_low_threshold", "bit_luminance_threshold", "maximum_fiducial_error_px",
    "maximum_marker_candidates_per_color", "maximum_marker_foreground_pixels",
    "maximum_marker_component_pixels", "maximum_marker_components_per_color",
    "maximum_frame_pixels", "capture_deadline_ms", "detector_deadline_ms",
    "freshness_limit_ms", "calibration_state", "execution_authority"
  ],
  "properties": {
    "profile": { "const": "combat_hud_tbc243_v6" },
    "profile_version": { "const": "0.6.0" },
    "target_profile": { "const": "tbc_243_lab" },
    "client_build": { "const": "2.4.3.8606" },
    "protocol_version": { "const": 6 },
    "magic": { "const": 198 },
    "grid_columns": { "const": 16 },
    "grid_rows": { "const": 14 },
    "cell_pitch_px": { "const": 3 },
    "fiducial_dx_px": { "const": 92 },
    "fiducial_dy_px": { "const": 34 },
    "first_cell_dx_px": { "const": 104 },
    "first_cell_dy_px": { "const": 0 },
    "search_height_fraction": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "search_width_fraction": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "marker_high_threshold": { "type": "integer", "minimum": 128, "maximum": 255 },
    "marker_low_threshold": { "type": "integer", "minimum": 0, "maximum": 127 },
    "bit_luminance_threshold": { "type": "integer", "minimum": 1, "maximum": 254 },
    "maximum_fiducial_error_px": { "type": "number", "exclusiveMinimum": 0, "maximum": 32 },
    "maximum_marker_candidates_per_color": { "type": "integer", "minimum": 1, "maximum": 32 },
    "maximum_marker_foreground_pixels": { "type": "integer", "minimum": 1, "maximum": 262144 },
    "maximum_marker_component_pixels": { "type": "integer", "minimum": 1, "maximum": 16384 },
    "maximum_marker_components_per_color": { "type": "integer", "minimum": 1, "maximum": 512 },
    "maximum_frame_pixels": { "type": "integer", "minimum": 1, "maximum": 16777216 },
    "capture_deadline_ms": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
    "detector_deadline_ms": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
    "freshness_limit_ms": { "const": 600 },
    "calibration_state": { "enum": ["synthetic_verified", "controlled_live_verified"] },
    "execution_authority": { "const": false }
  },
  "additionalProperties": false
}
