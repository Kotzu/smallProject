{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfect-assassin.local/contracts/lab-client-launch-receipt.schema.json",
  "title": "Perfect Assassin LAB client launch receipt v1.0",
  "$comment": "Breaking replacement for legacy v0.1. Legacy v0.1 is accepted only by the one-time continuity adoption path; normal authority accepts v1.0 only.",
  "type": "object",
  "required": [
    "record_type", "schema_version", "receipt_nonce", "pid", "hwnd",
    "process_created_at_utc", "process_creation_filetime_utc", "windows_session_id",
    "identity_origin", "parent_receipt_nonce", "parent_receipt_sha256",
    "parent_authorization_sha256",
    "window_title", "window_class", "executable_path", "executable_sha256",
    "client_build", "build_signature", "target_profile", "authorization_id",
    "authorization_sha256", "authorization_semantic_sha256", "actor_binding", "environment_scope", "server_kind",
    "expected_realm_fingerprint", "realm_assurance", "realm_routing_sha256",
    "realmlist_relative_path", "realmlist_sha256",
    "realmlist_directive", "decision_context", "created_at", "expires_at", "scope",
    "execution_authority"
  ],
  "properties": {
    "record_type": { "const": "lab_client_launch_receipt" },
    "schema_version": { "const": "1.0" },
    "receipt_nonce": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{8}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{12}$"
    },
    "pid": { "type": "integer", "minimum": 1 },
    "hwnd": { "type": "string", "pattern": "^0x[A-F0-9]+$" },
    "process_created_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "process_creation_filetime_utc": {
      "type": "string",
      "pattern": "^[0-9]{17,20}$"
    },
    "windows_session_id": { "type": "integer", "minimum": 0 },
    "identity_origin": {
      "enum": [
        "operator_launch",
        "legacy_v0_1_continuity_adoption",
        "verified_receipt_renewal"
      ]
    },
    "parent_receipt_nonce": {
      "type": ["string", "null"],
      "pattern": "^[A-Fa-f0-9]{8}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{12}$"
    },
    "parent_receipt_sha256": {
      "type": ["string", "null"],
      "pattern": "^[A-F0-9]{64}$"
    },
    "parent_authorization_sha256": {
      "type": ["string", "null"],
      "pattern": "^[A-F0-9]{64}$"
    },
    "window_title": { "const": "World of Warcraft" },
    "window_class": { "const": "GxWindowClassD3d" },
    "executable_path": { "type": "string", "minLength": 1 },
    "executable_sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "client_build": { "type": "string", "minLength": 1 },
    "build_signature": { "type": "string", "minLength": 1 },
    "target_profile": { "type": "string", "minLength": 1 },
    "authorization_id": { "type": "string", "minLength": 1 },
    "authorization_sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "authorization_semantic_sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "actor_binding": { "$ref": "#/$defs/actorBinding" },
    "environment_scope": { "const": "emulator_local" },
    "server_kind": { "const": "emulator" },
    "expected_realm_fingerprint": { "type": "string", "minLength": 1 },
    "realm_assurance": { "$ref": "#/$defs/realmAssurance" },
    "realm_routing_sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "realmlist_relative_path": { "type": "string", "minLength": 1 },
    "realmlist_sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "realmlist_directive": { "type": "string", "minLength": 1 },
    "decision_context": { "const": "lab_clone" },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "scope": { "const": "lab_evaluation_only" },
    "execution_authority": { "const": false }
  },
  "allOf": [
    {
      "if": {
        "properties": { "identity_origin": { "const": "operator_launch" } },
        "required": ["identity_origin"]
      },
      "then": {
        "properties": {
          "parent_receipt_nonce": { "const": null },
          "parent_receipt_sha256": { "const": null },
          "parent_authorization_sha256": { "const": null }
        }
      },
      "else": {
        "properties": {
          "parent_receipt_nonce": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{8}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{12}$"
          },
          "parent_receipt_sha256": {
            "type": "string",
            "pattern": "^[A-F0-9]{64}$"
          },
          "parent_authorization_sha256": {
            "type": "string",
            "pattern": "^[A-F0-9]{64}$"
          }
        }
      }
    }
  ],
  "$defs": {
    "actorBinding": {
      "type": "object",
      "required": ["schema_version", "instance_id", "actor_role", "actor_id", "decision_context", "memory_namespace", "expected_character_name", "credential_alias", "binding_assurance"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "instance_id": { "type": "string", "minLength": 1 },
        "actor_role": { "const": "lab_clone" },
        "actor_id": { "type": "string", "minLength": 1 },
        "decision_context": { "const": "lab_clone" },
        "memory_namespace": { "type": "string", "pattern": "^memory:lab:" },
        "expected_character_name": { "const": "Predator" },
        "credential_alias": { "const": "credential:lab:pa_observer" },
        "binding_assurance": {
          "type": "object",
          "required": ["state", "evidence_refs"],
          "properties": {
            "state": { "const": "configured_expected_only" },
            "evidence_refs": {
              "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 256 }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "realmAssurance": {
      "type": "object",
      "required": ["state", "method", "verified_at"],
      "properties": {
        "state": { "const": "local_process_config_verified_at_launch" },
        "method": { "const": "exact_realmlist_listener_process_config_and_realm_route" },
        "verified_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
