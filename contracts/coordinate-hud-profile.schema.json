{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfect-assassin.local/contracts/coordinate-hud-profile.schema.json",
  "title": "Visible coordinate HUD detector profile",
  "type": "object",
  "required": [
    "profile", "profile_version", "target_profile", "client_build",
    "protocol_version", "magic", "grid_columns", "grid_rows",
    "cell_pitch_px", "fiducial_dx_px", "fiducial_dy_px",
    "first_cell_dx_px", "first_cell_dy_px", "search_height_fraction", "search_width_fraction",
    "marker_high_threshold", "marker_low_threshold",
    "bit_luminance_threshold", "maximum_fiducial_error_px",
    "maximum_marker_candidates_per_color", "maximum_marker_foreground_pixels",
    "maximum_marker_component_pixels", "maximum_marker_components_per_color", "maximum_frame_pixels",
    "capture_deadline_ms", "detector_deadline_ms", "freshness_limit_ms", "calibration_state",
    "execution_authority"
  ],
  "properties": {
    "profile": { "type": "string", "minLength": 1 },
    "profile_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "target_profile": { "type": "string", "minLength": 1 },
    "client_build": { "type": "string", "minLength": 1 },
    "protocol_version": { "const": 3 },
    "magic": { "const": 165 },
    "grid_columns": { "const": 16 },
    "grid_rows": { "const": 7 },
    "cell_pitch_px": { "type": "number", "exclusiveMinimum": 0 },
    "fiducial_dx_px": { "type": "number", "exclusiveMinimum": 0 },
    "fiducial_dy_px": { "type": "number", "exclusiveMinimum": 0 },
    "first_cell_dx_px": { "type": "number" },
    "first_cell_dy_px": { "type": "number" },
    "search_height_fraction": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "search_width_fraction": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "marker_high_threshold": { "type": "integer", "minimum": 1, "maximum": 255 },
    "marker_low_threshold": { "type": "integer", "minimum": 0, "maximum": 254 },
    "bit_luminance_threshold": { "type": "number", "minimum": 0, "maximum": 255 },
    "maximum_fiducial_error_px": { "type": "number", "exclusiveMinimum": 0 },
    "maximum_marker_candidates_per_color": { "type": "integer", "minimum": 1, "maximum": 32 },
    "maximum_marker_foreground_pixels": { "type": "integer", "minimum": 4, "maximum": 262144 },
    "maximum_marker_component_pixels": { "type": "integer", "minimum": 4, "maximum": 65536 },
    "maximum_marker_components_per_color": { "type": "integer", "minimum": 4, "maximum": 1024 },
    "maximum_frame_pixels": { "type": "integer", "minimum": 1, "maximum": 16777216 },
    "capture_deadline_ms": { "type": "number", "exclusiveMinimum": 0, "maximum": 2000 },
    "detector_deadline_ms": { "type": "number", "exclusiveMinimum": 0, "maximum": 2000 },
    "freshness_limit_ms": { "type": "number", "exclusiveMinimum": 0, "maximum": 5000 },
    "calibration_state": { "enum": ["synthetic_verified", "controlled_live_verified"] },
    "execution_authority": { "const": false }
  },
  "additionalProperties": false
}
