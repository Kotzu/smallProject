{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfect-assassin.local/contracts/world-pack-runtime-profile.schema.json",
  "title": "Perfect Assassin WorldPack runtime profile v1",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "map": {
      "type": "object",
      "required": ["map_id", "internal_name"],
      "properties": {
        "map_id": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "internal_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_ '-]{0,95}$"
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "record_type", "schema_version", "profile_id", "pack_directory_name",
    "pack_id", "content_sha256", "catalog_id", "target_profile",
    "client_version", "client_build", "nav_profile_id", "maps",
    "execution_authority"
  ],
  "properties": {
    "record_type": { "const": "world_pack_runtime_profile" },
    "schema_version": { "const": "1.0" },
    "profile_id": { "$ref": "#/$defs/identifier" },
    "pack_directory_name": {
      "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "pack_id": { "$ref": "#/$defs/identifier" },
    "content_sha256": { "$ref": "#/$defs/sha256" },
    "catalog_id": { "$ref": "#/$defs/identifier" },
    "target_profile": { "$ref": "#/$defs/identifier" },
    "client_version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "client_build": { "type": "string", "minLength": 1, "maxLength": 32 },
    "nav_profile_id": { "$ref": "#/$defs/identifier" },
    "maps": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": { "$ref": "#/$defs/map" }
    },
    "execution_authority": { "const": false }
  },
  "additionalProperties": false
}
