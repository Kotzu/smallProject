{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfect-assassin.local/contracts/external-integration.schema.json",
  "title": "Perfect Assassin external integration manifest v0.1",
  "type": "object",
  "required": [
    "schema_version", "integration_id", "purpose", "deployment_state",
    "upstream_url", "license", "artifacts", "local_paths", "verified_at"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "integration_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+$" },
    "purpose": { "type": "string", "minLength": 1 },
    "deployment_state": {
      "enum": ["researched", "staged", "deployed_unverified", "controlled_live_verified"]
    },
    "upstream_url": { "type": "string", "format": "uri" },
    "license": { "type": "string", "minLength": 1 },
    "pinned_ref": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "source_url", "sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "source_url": { "type": "string", "format": "uri" },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "local_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "deployment_adjustments": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "verified_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
