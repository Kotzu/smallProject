{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfect-assassin.local/contracts/zygor-world-map-reconciliation.schema.json",
  "title": "Content-minimal Zygor to client WorldMapArea reconciliation v1",
  "type": "object",
  "required": [
    "record_type", "schema_version", "npcdata_discovery_reference",
    "npcdata_source_sha256", "map_source_reference", "map_source_sha256",
    "map_source_size_bytes", "world_map_area_reference",
    "world_map_area_asset_sha256", "world_map_area_record_count",
    "provider_version", "client_version", "client_build", "map_area_count",
    "exact_map_area_count", "normalized_exact_map_area_count",
    "resolved_map_area_count", "ambiguous_map_area_count",
    "unresolved_map_area_count", "reconciliation_status", "map_areas",
    "execution_authority"
  ],
  "properties": {
    "record_type": { "const": "zygor_world_map_reconciliation" },
    "schema_version": { "const": "1.0" },
    "npcdata_discovery_reference": { "type": "string", "minLength": 1, "maxLength": 512 },
    "npcdata_source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "map_source_reference": { "type": "string", "minLength": 1, "maxLength": 512 },
    "map_source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "map_source_size_bytes": { "type": "integer", "minimum": 1 },
    "world_map_area_reference": { "type": "string", "minLength": 1, "maxLength": 512 },
    "world_map_area_asset_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "world_map_area_record_count": { "type": "integer", "minimum": 1 },
    "provider_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "client_version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "client_build": { "type": "string", "minLength": 1, "maxLength": 32 },
    "map_area_count": { "type": "integer", "minimum": 1 },
    "exact_map_area_count": { "type": "integer", "minimum": 0 },
    "normalized_exact_map_area_count": { "type": "integer", "minimum": 0 },
    "resolved_map_area_count": { "type": "integer", "minimum": 0 },
    "ambiguous_map_area_count": { "type": "integer", "minimum": 0 },
    "unresolved_map_area_count": { "type": "integer", "minimum": 0 },
    "reconciliation_status": { "enum": ["COMPLETE", "PARTIAL", "UNRESOLVED"] },
    "map_areas": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["map_id", "row_count", "binding_status", "world_map_ids"],
        "properties": {
          "map_id": { "type": "integer", "minimum": 0 },
          "row_count": { "type": "integer", "minimum": 1 },
          "binding_status": {
            "enum": ["EXACT", "NORMALIZED_EXACT", "AMBIGUOUS", "UNRESOLVED"]
          },
          "world_map_ids": {
            "type": "array", "uniqueItems": true,
            "items": { "type": "integer", "minimum": 0 }
          }
        },
        "additionalProperties": false
      }
    },
    "execution_authority": { "const": false }
  },
  "additionalProperties": false
}
