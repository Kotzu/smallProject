{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfect-assassin.local/contracts/client-world-bake-queue.schema.json",
  "title": "Perfect Assassin client world bake queue v1",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "path": { "type": "string", "minLength": 3, "maxLength": 1024 },
    "bounds": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 0, "maximum": 63 },
        { "type": "integer", "minimum": 0, "maximum": 63 },
        { "type": "integer", "minimum": 0, "maximum": 63 },
        { "type": "integer", "minimum": 0, "maximum": 63 }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "map": {
      "type": "object",
      "required": [
        "map_id", "internal_name", "adt_count", "adt_bounds",
        "asset_complete", "road_semantics_complete", "navmesh_complete",
        "state", "next_action", "asset_directory", "nav_directory",
        "map_file", "execution_authority"
      ],
      "properties": {
        "map_id": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "internal_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_ '-]{0,95}$"
        },
        "adt_count": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "adt_bounds": { "$ref": "#/$defs/bounds" },
        "asset_complete": { "type": "boolean" },
        "road_semantics_complete": { "type": "boolean" },
        "navmesh_complete": { "type": "boolean" },
        "state": {
          "enum": [
            "READY_FOR_EXTRACTION", "EXTRACTION_PARTIAL",
            "READY_FOR_SEMANTICS", "SEMANTICS_PARTIAL",
            "READY_FOR_NAVMESH", "NAVMESH_PARTIAL",
            "INCONSISTENT_DOWNSTREAM_ARTIFACTS", "COMPLETE"
          ]
        },
        "next_action": {
          "enum": [
            "EXTRACT_MAP_ASSETS", "RESTART_MAP_EXTRACTION",
            "BUILD_ROAD_SEMANTICS", "RESUME_ROAD_SEMANTICS",
            "BUILD_NAVMESH", "RESUME_NAVMESH",
            "AUDIT_VERSIONED_MAP_ARTIFACTS", "VALIDATE_CATALOG"
          ]
        },
        "asset_directory": { "$ref": "#/$defs/path" },
        "nav_directory": { "$ref": "#/$defs/path" },
        "map_file": { "$ref": "#/$defs/path" },
        "execution_authority": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "record_type", "schema_version", "catalog_id", "product", "expansion",
    "client_version", "client_build", "asset_container",
    "asset_parser_profile", "asset_root", "nav_root", "bvh_directory",
    "bvh_index", "bvh_artifact_count", "bvh_ready", "eligible_map_count",
    "eligible_adt_count", "complete_map_count", "maps",
    "execution_authority"
  ],
  "properties": {
    "record_type": { "const": "client_world_bake_queue" },
    "schema_version": { "const": "1.0" },
    "catalog_id": { "$ref": "#/$defs/identifier" },
    "product": { "$ref": "#/$defs/identifier" },
    "expansion": { "$ref": "#/$defs/identifier" },
    "client_version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "client_build": { "type": "string", "minLength": 1, "maxLength": 32 },
    "asset_container": { "enum": ["mpq", "casc"] },
    "asset_parser_profile": { "$ref": "#/$defs/identifier" },
    "asset_root": { "$ref": "#/$defs/path" },
    "nav_root": { "$ref": "#/$defs/path" },
    "bvh_directory": { "$ref": "#/$defs/path" },
    "bvh_index": { "$ref": "#/$defs/path" },
    "bvh_artifact_count": {
      "type": "integer", "minimum": 0, "maximum": 1000000
    },
    "bvh_ready": { "type": "boolean" },
    "eligible_map_count": { "type": "integer", "minimum": 1, "maximum": 4096 },
    "eligible_adt_count": { "type": "integer", "minimum": 1, "maximum": 16777216 },
    "complete_map_count": { "type": "integer", "minimum": 0, "maximum": 4096 },
    "maps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/map" }
    },
    "execution_authority": { "const": false }
  },
  "additionalProperties": false
}
