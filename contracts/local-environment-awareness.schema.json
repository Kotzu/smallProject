{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfect-assassin.local/contracts/local-environment-awareness.schema.json",
  "title": "Perfect Assassin local environment awareness v1",
  "$defs": {
    "point": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": { "type": "number" }
    },
    "surface": { "enum": ["ground", "wmo", "doodad"] },
    "structure": {
      "type": "object",
      "required": ["structure_id", "asset_path", "nav_coverage", "evidence", "confidence"],
      "properties": {
        "structure_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$" },
        "asset_path": { "type": "string", "minLength": 1, "maxLength": 512 },
        "nav_coverage": { "enum": ["FULL", "PARTIAL", "NONE", "GLOBAL_WMO"] },
        "evidence": { "const": "AABB_3D_PLUS_WMO_NAV_SURFACE" },
        "confidence": { "const": 0.95 }
      },
      "additionalProperties": false
    },
    "boundary": {
      "type": "object",
      "required": [
        "left", "right", "midpoint", "bearing_rad", "distance_yards",
        "length_yards", "kind", "physical_wall_semantics", "topology_confidence"
      ],
      "properties": {
        "left": { "$ref": "#/$defs/point" },
        "right": { "$ref": "#/$defs/point" },
        "midpoint": { "$ref": "#/$defs/point" },
        "bearing_rad": { "type": "number", "minimum": 0, "exclusiveMaximum": 6.283185307179587 },
        "distance_yards": { "type": "number", "minimum": 0 },
        "length_yards": { "type": "number", "exclusiveMinimum": 0 },
        "kind": { "const": "NAVMESH_COMPONENT_BOUNDARY" },
        "physical_wall_semantics": { "const": "CANDIDATE_NOT_OBJECT_CLASSIFIED" },
        "topology_confidence": { "const": 1.0 }
      },
      "additionalProperties": false
    },
    "egress": {
      "type": "object",
      "required": [
        "left", "right", "midpoint", "bearing_rad", "width_yards",
        "distance_yards", "route_distance_yards", "from_surfaces", "to_surfaces",
        "kind", "route_verified", "topology_confidence"
      ],
      "properties": {
        "left": { "$ref": "#/$defs/point" },
        "right": { "$ref": "#/$defs/point" },
        "midpoint": { "$ref": "#/$defs/point" },
        "bearing_rad": { "type": "number", "minimum": 0, "exclusiveMaximum": 6.283185307179587 },
        "width_yards": { "type": "number", "exclusiveMinimum": 0 },
        "distance_yards": { "type": "number", "minimum": 0 },
        "route_distance_yards": { "type": "number", "minimum": 0 },
        "from_surfaces": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/surface" } },
        "to_surfaces": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/surface" } },
        "kind": { "const": "VERIFIED_TOPOLOGICAL_EGRESS" },
        "route_verified": { "const": true },
        "topology_confidence": { "const": 1.0 }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "record_type", "schema_version", "map_name", "observed_monotonic_s",
    "position", "environment_state", "environment_confidence", "physical_surfaces",
    "topology_complete", "containing_structures", "boundaries", "verified_egresses",
    "candidate_opening_bearings_rad", "nearby_wmo_count",
    "nearby_static_obstacle_count", "source", "execution_authority"
  ],
  "properties": {
    "record_type": { "const": "local_environment_awareness" },
    "schema_version": { "const": "1.0" },
    "map_name": { "type": "string", "minLength": 1, "maxLength": 96 },
    "observed_monotonic_s": { "type": "number", "minimum": 0 },
    "position": { "$ref": "#/$defs/point" },
    "environment_state": {
      "enum": [
        "INSIDE_STATIC_WMO", "OPEN_GROUND", "CONFINED_STATIC_SPACE",
        "STATIC_TRANSITION", "WMO_TRANSITION_OR_UNRESOLVED"
      ]
    },
    "environment_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "physical_surfaces": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/surface" } },
    "topology_complete": { "type": "boolean" },
    "containing_structures": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/structure" } },
    "boundaries": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/boundary" } },
    "verified_egresses": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/egress" } },
    "candidate_opening_bearings_rad": {
      "type": "array", "maxItems": 64,
      "items": { "type": "number", "minimum": 0, "exclusiveMaximum": 6.283185307179587 }
    },
    "nearby_wmo_count": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "nearby_static_obstacle_count": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "source": { "const": "WORLD_PACK_STRUCTURE_INDEX_PLUS_DETOUR_BVH" },
    "execution_authority": { "const": false }
  },
  "additionalProperties": false
}
