{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfect-assassin.local/contracts/capability-profile.schema.json",
  "title": "Compatibility capability profile",
  "type": "object",
  "required": ["profile", "version", "default", "capabilities"],
  "properties": {
    "profile": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "default": { "const": "deny" },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "enum": ["available", "restricted", "unavailable", "unknown"] }
    }
  },
  "additionalProperties": false
}
