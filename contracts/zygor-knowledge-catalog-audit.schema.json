{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfect-assassin.local/contracts/zygor-knowledge-catalog-audit.schema.json",
  "title": "Zygor knowledge catalog offline audit v1",
  "type": "object",
  "required": [
    "record_type", "schema_version", "client_version", "client_build",
    "catalog_count", "catalogs", "dynamic_position_policy",
    "input_emitted", "execution_authority", "server_truth_used"
  ],
  "properties": {
    "record_type": { "const": "zygor_knowledge_catalog_audit" },
    "schema_version": { "const": "1.0" },
    "client_version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "client_build": { "type": "string", "minLength": 1, "maxLength": 32 },
    "catalog_count": { "type": "integer", "minimum": 1 },
    "catalogs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "catalog_path", "catalog_id", "target_profile", "entry_count",
          "position_count", "missing_position_count", "kind_counts",
          "confidence_counts", "provider_counts", "origin_counts",
          "position_semantics_counts", "execution_authority"
        ],
        "properties": {
          "catalog_path": { "type": "string", "minLength": 1, "maxLength": 512 },
          "catalog_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "target_profile": { "type": "string", "minLength": 1, "maxLength": 128 },
          "entry_count": { "type": "integer", "minimum": 1 },
          "position_count": { "type": "integer", "minimum": 0 },
          "missing_position_count": { "type": "integer", "minimum": 0 },
          "kind_counts": {
            "type": "object", "minProperties": 1,
            "additionalProperties": { "type": "integer", "minimum": 1 }
          },
          "confidence_counts": {
            "type": "object", "minProperties": 1,
            "additionalProperties": { "type": "integer", "minimum": 1 }
          },
          "provider_counts": {
            "type": "object", "minProperties": 1,
            "additionalProperties": { "type": "integer", "minimum": 1 }
          },
          "origin_counts": {
            "type": "object", "minProperties": 1,
            "additionalProperties": { "type": "integer", "minimum": 1 }
          },
          "position_semantics_counts": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 1 }
          },
          "execution_authority": { "const": false }
        },
        "additionalProperties": false
      }
    },
    "dynamic_position_policy": {
      "const": "CLIENT_OBSERVED_CONFIRMATION_REQUIRED"
    },
    "input_emitted": { "const": false },
    "execution_authority": { "const": false },
    "server_truth_used": { "const": false }
  },
  "additionalProperties": false
}
