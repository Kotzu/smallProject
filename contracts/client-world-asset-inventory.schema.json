{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfect-assassin.local/contracts/client-world-asset-inventory.schema.json",
  "title": "Perfect Assassin client world asset inventory v1",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "tile": {
      "type": "object",
      "required": ["grid_x", "grid_y"],
      "properties": {
        "grid_x": { "type": "integer", "minimum": 0, "maximum": 63 },
        "grid_y": { "type": "integer", "minimum": 0, "maximum": 63 }
      },
      "additionalProperties": false
    },
    "bounds": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 0, "maximum": 63 },
        { "type": "integer", "minimum": 0, "maximum": 63 },
        { "type": "integer", "minimum": 0, "maximum": 63 },
        { "type": "integer", "minimum": 0, "maximum": 63 }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "map": {
      "type": "object",
      "required": [
        "map_id", "internal_name", "wdt_present", "adt_count",
        "adt_bounds", "tiles"
      ],
      "properties": {
        "map_id": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "internal_name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "wdt_present": { "type": "boolean" },
        "adt_count": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "adt_bounds": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/bounds" }
          ]
        },
        "tiles": {
          "type": "array",
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/tile" }
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "record_type", "schema_version", "catalog_id", "target_profile",
    "product", "expansion", "client_version", "client_build",
    "asset_container", "asset_parser_profile", "world_catalog_asset",
    "world_catalog_asset_sha256", "map_count", "maps",
    "execution_authority"
  ],
  "properties": {
    "record_type": { "const": "client_world_asset_inventory" },
    "schema_version": { "const": "1.0" },
    "catalog_id": { "$ref": "#/$defs/identifier" },
    "target_profile": { "$ref": "#/$defs/identifier" },
    "product": { "$ref": "#/$defs/identifier" },
    "expansion": { "$ref": "#/$defs/identifier" },
    "client_version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "client_build": { "type": "string", "minLength": 1, "maxLength": 32 },
    "asset_container": { "const": "mpq" },
    "asset_parser_profile": { "$ref": "#/$defs/identifier" },
    "world_catalog_asset": { "type": "string", "minLength": 1, "maxLength": 256 },
    "world_catalog_asset_sha256": { "$ref": "#/$defs/sha256" },
    "map_count": { "type": "integer", "minimum": 1, "maximum": 4096 },
    "maps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/map" }
    },
    "execution_authority": { "const": false }
  },
  "additionalProperties": false
}
