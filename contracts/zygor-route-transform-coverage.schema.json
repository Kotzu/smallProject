{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfect-assassin.local/contracts/zygor-route-transform-coverage.schema.json",
  "title": "Content-minimal Zygor route to client 2D transform coverage v1",
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "map_count": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "map_id", "map_name", "coordinate_candidate_count",
        "transformed_coordinate_count", "unresolved_coordinate_count",
        "transform_area_count"
      ],
      "properties": {
        "map_id": {"type": "integer", "minimum": 0},
        "map_name": {"type": "string", "minLength": 1, "maxLength": 96},
        "coordinate_candidate_count": {"$ref": "#/$defs/count"},
        "transformed_coordinate_count": {"$ref": "#/$defs/count"},
        "unresolved_coordinate_count": {"$ref": "#/$defs/count"},
        "transform_area_count": {"$ref": "#/$defs/count"}
      }
    },
    "transform_count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["map_id", "area_id", "coordinate_count"],
      "properties": {
        "map_id": {"type": "integer", "minimum": 0},
        "area_id": {"type": "integer", "minimum": 0},
        "coordinate_count": {"$ref": "#/$defs/count"}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archive_path", "source_sha256", "source_size_bytes",
        "coordinate_candidate_count", "transformed_coordinate_count",
        "unresolved_coordinate_count", "transform_error_count",
        "map_coverage", "transform_coverage", "execution_authority"
      ],
      "properties": {
        "archive_path": {
          "type": "string", "pattern": "^[A-Za-z0-9._/-]{1,260}$"
        },
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "source_size_bytes": {"type": "integer", "minimum": 1},
        "coordinate_candidate_count": {"$ref": "#/$defs/count"},
        "transformed_coordinate_count": {"$ref": "#/$defs/count"},
        "unresolved_coordinate_count": {"$ref": "#/$defs/count"},
        "transform_error_count": {"$ref": "#/$defs/count"},
        "map_coverage": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {"$ref": "#/$defs/map_count"}
        },
        "transform_coverage": {
          "type": "array", "maxItems": 128,
          "items": {"$ref": "#/$defs/transform_count"}
        },
        "execution_authority": {"const": false}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type", "schema_version", "source_archive_reference",
    "source_archive_sha256", "source_archive_size_bytes", "provider_version",
    "client_version", "client_build", "binding_reference",
    "transform_catalog_reference", "transform_asset_sha256",
    "transform_record_fingerprint_sha256", "selected_file_count", "files",
    "coordinate_candidate_count", "transformed_coordinate_count",
    "unresolved_coordinate_count", "transform_error_count", "map_coverage",
    "transform_coverage", "unresolved_transform_key_hashes", "coverage_state",
    "execution_authority"
  ],
  "properties": {
    "record_type": {"const": "zygor_route_transform_coverage"},
    "schema_version": {"const": "1.0"},
    "source_archive_reference": {"type": "string", "minLength": 1, "maxLength": 512},
    "source_archive_sha256": {"$ref": "#/$defs/sha256"},
    "source_archive_size_bytes": {"type": "integer", "minimum": 1},
    "provider_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "client_version": {"type": "string", "minLength": 1, "maxLength": 32},
    "client_build": {"type": "string", "minLength": 1, "maxLength": 32},
    "binding_reference": {"type": "string", "minLength": 1, "maxLength": 512},
    "transform_catalog_reference": {"type": "string", "minLength": 1, "maxLength": 512},
    "transform_asset_sha256": {"$ref": "#/$defs/sha256"},
    "transform_record_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
    "selected_file_count": {"type": "integer", "minimum": 1, "maximum": 32},
    "files": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {"$ref": "#/$defs/file"}
    },
    "coordinate_candidate_count": {"$ref": "#/$defs/count"},
    "transformed_coordinate_count": {"$ref": "#/$defs/count"},
    "unresolved_coordinate_count": {"$ref": "#/$defs/count"},
    "transform_error_count": {"$ref": "#/$defs/count"},
    "map_coverage": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {"$ref": "#/$defs/map_count"}
    },
    "transform_coverage": {
      "type": "array", "maxItems": 128,
      "items": {"$ref": "#/$defs/transform_count"}
    },
    "unresolved_transform_key_hashes": {
      "type": "array", "maxItems": 256,
      "items": {"$ref": "#/$defs/sha256"},
      "uniqueItems": true
    },
    "coverage_state": {
      "enum": ["COMPLETE_CLIENT_2D_TRANSFORM", "PARTIAL_CLIENT_2D_TRANSFORM"]
    },
    "execution_authority": {"const": false}
  }
}
