{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfect-assassin.local/contracts/combat-decision.schema.json",
  "title": "Rogue Predator combat decision v1.0",
  "type": "object",
  "required": [
    "record_type", "schema_version", "decision_id", "observation_id",
    "observation_sha256", "authorization_sha256", "actor_id", "actor_instance_id",
    "target_profile", "created_at", "observed_monotonic_s",
    "observation_expires_monotonic_s", "source_sequence", "target_identity_crc16",
    "bearing_observation_id", "bearing_observation_sha256",
    "bearing_tracking_state", "bearing_direction", "bearing_offset_x_normalized",
    "bearing_expires_monotonic_s",
    "priority_tier", "action_id", "reason_code", "explanation", "requested_control",
    "preconditions", "confidence", "provenance", "execution_authority"
  ],
  "properties": {
    "record_type": { "const": "combat_decision" },
    "schema_version": { "const": "1.0" },
    "decision_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "observation_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "observation_sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "authorization_sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "actor_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "actor_instance_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "target_profile": { "type": "string", "minLength": 1, "maxLength": 128 },
    "created_at": { "type": "string", "format": "date-time" },
    "observed_monotonic_s": { "type": "number", "minimum": 0 },
    "observation_expires_monotonic_s": { "type": "number", "minimum": 0 },
    "source_sequence": { "type": "integer", "minimum": 0, "maximum": 255 },
    "target_identity_crc16": {
      "oneOf": [
        { "type": "null" },
        { "type": "integer", "minimum": 1, "maximum": 65535 }
      ]
    },
    "bearing_observation_id": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1, "maxLength": 160 }
      ]
    },
    "bearing_observation_sha256": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[A-F0-9]{64}$" }
      ]
    },
    "bearing_tracking_state": {
      "oneOf": [
        { "type": "null" },
        { "enum": ["VISIBLE", "LOST", "AMBIGUOUS"] }
      ]
    },
    "bearing_direction": {
      "oneOf": [
        { "type": "null" },
        { "enum": ["LEFT", "CENTER", "RIGHT"] }
      ]
    },
    "bearing_offset_x_normalized": {
      "oneOf": [
        { "type": "null" },
        { "type": "number", "minimum": -1, "maximum": 1 }
      ]
    },
    "bearing_expires_monotonic_s": {
      "oneOf": [
        { "type": "null" },
        { "type": "number", "minimum": 0 }
      ]
    },
    "priority_tier": { "enum": ["SURVIVAL", "SAFETY", "TARGET_CONTROL", "DAMAGE", "RECOVERY"] },
    "action_id": {
      "enum": [
        "combat.stop_player_dead", "combat.request_safe_retreat",
        "combat.acquire_hostile_target", "combat.scan_for_hostile_target", "combat.scan_for_hostile_target_left",
        "combat.turn_toward_visible_candidate_left", "combat.turn_toward_visible_candidate_right",
        "combat.cycle_hostile_target",
        "combat.reject_player_target",
        "combat.reject_non_hostile_target", "combat.target_defeated",
        "combat.reject_risky_target", "combat.stop_action_binding_mismatch",
        "combat.approach_target", "combat.turn_toward_target_left",
        "combat.turn_toward_target_right", "combat.search_selected_target", "combat.search_selected_target_left",
        "combat.orbit_target_left", "combat.orbit_target_right",
        "recovery.select_last_defeated", "recovery.loot_defeated_target",
        "combat.hold_bearing_unavailable", "rogue.auto_attack", "combat.hold_range_unknown",
        "rogue.eviscerate", "rogue.sinister_strike", "combat.monitor_auto_attack"
      ]
    },
    "reason_code": { "type": "string", "minLength": 1, "maxLength": 96 },
    "explanation": { "type": "string", "minLength": 1, "maxLength": 512 },
    "requested_control": {
      "oneOf": [
        { "type": "null" },
        { "enum": ["MOVE_BACKWARD", "MOVE_FORWARD", "STRAFE_LEFT", "STRAFE_RIGHT", "TURN_LEFT", "TURN_RIGHT", "TARGET_VISIBLE_HOSTILE", "TARGET_NEAREST_HOSTILE", "TARGET_LAST_HOSTILE", "INTERACT_TARGET", "ACTION_SLOT_1", "ACTION_SLOT_2", "ACTION_SLOT_3"] }
      ]
    },
    "preconditions": {
      "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "confidence": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "provenance": {
      "type": "object",
      "required": ["origin", "policy_id", "policy_version", "source_scope", "evidence_refs"],
      "properties": {
        "origin": { "const": "deterministic_combat_policy" },
        "policy_id": { "const": "rogue_level1_combat_v2" },
        "policy_version": { "const": "2.0.0" },
        "source_scope": { "enum": ["synthetic_fixture", "lab_evaluation_only", "unpromoted_evaluation_only"] },
        "evidence_refs": {
          "type": "array", "minItems": 2, "maxItems": 8, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      },
      "additionalProperties": false
    },
    "execution_authority": { "const": false }
  },
  "additionalProperties": false
}
