{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfect-assassin.local/contracts/navmesh-tile-repair-evidence.schema.json",
  "title": "Perfect Assassin navmesh tile repair evidence v1",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifact_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)[.][.]?(?:/|$))(?!.*\\\\).{1,512}$"
    }
  },
  "type": "object",
  "required": [
    "record_type", "schema_version", "catalog_id", "client_build",
    "map_id", "internal_name", "tile", "raw_bake_report_sha256",
    "defect", "replacement_source", "regression", "execution_authority"
  ],
  "properties": {
    "record_type": { "const": "navmesh_tile_repair_evidence" },
    "schema_version": { "const": "1.0" },
    "catalog_id": { "$ref": "#/$defs/identifier" },
    "client_build": { "type": "string", "minLength": 1, "maxLength": 32 },
    "map_id": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "internal_name": {
      "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_ '-]{0,95}$"
    },
    "tile": {
      "type": "object",
      "required": [
        "grid_x", "grid_y", "artifact", "raw_bake_sha256",
        "replacement_sha256"
      ],
      "properties": {
        "grid_x": { "type": "integer", "minimum": 0, "maximum": 63 },
        "grid_y": { "type": "integer", "minimum": 0, "maximum": 63 },
        "artifact": { "type": "string", "pattern": "^[0-9]{2}_[0-9]{2}\\.nav$" },
        "raw_bake_sha256": { "$ref": "#/$defs/sha256" },
        "replacement_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "raw_bake_report_sha256": { "$ref": "#/$defs/sha256" },
    "defect": {
      "type": "object",
      "required": ["failure_code", "evidence_artifact", "evidence_sha256"],
      "properties": {
        "failure_code": { "$ref": "#/$defs/identifier" },
        "evidence_artifact": { "$ref": "#/$defs/artifact_path" },
        "evidence_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "replacement_source": {
      "type": "object",
      "required": ["pack_id", "pack_content_sha256", "relative_path", "artifact_sha256"],
      "properties": {
        "pack_id": { "$ref": "#/$defs/identifier" },
        "pack_content_sha256": { "$ref": "#/$defs/sha256" },
        "relative_path": { "$ref": "#/$defs/artifact_path" },
        "artifact_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "regression": {
      "type": "object",
      "required": ["scenario_id", "before", "after"],
      "properties": {
        "scenario_id": { "$ref": "#/$defs/identifier" },
        "before": {
          "type": "object",
          "required": ["status", "result_artifact", "result_sha256"],
          "properties": {
            "status": { "const": "FAILED" },
            "result_artifact": { "$ref": "#/$defs/artifact_path" },
            "result_sha256": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        },
        "after": {
          "type": "object",
          "required": ["status", "result_artifact", "result_sha256"],
          "properties": {
            "status": { "const": "PASSED" },
            "result_artifact": { "$ref": "#/$defs/artifact_path" },
            "result_sha256": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "execution_authority": { "const": false }
  },
  "additionalProperties": false
}
