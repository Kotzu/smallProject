{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfect-assassin.local/contracts/dynamic-encounter-observation.schema.json",
  "title": "Permanent observed dynamic encounter v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type", "schema_version", "event_id", "session_id", "map_name",
    "navmesh_sha256", "observed_at_utc", "observed_monotonic_s",
    "observer_world_position", "observer_facing_rad", "observer_facing_semantics",
    "track_id", "reaction",
    "center_x_normalized", "center_y_normalized", "width_normalized",
    "height_normalized", "confidence", "position_uncertainty_normalized",
    "observation_count", "source_key", "experience_semantics",
    "entity_position_semantics", "entity_world_position", "execution_authority"
  ],
  "properties": {
    "record_type": { "const": "dynamic_encounter_observation" },
    "schema_version": { "const": "1.0" },
    "event_id": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "session_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "map_name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "navmesh_sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "observed_at_utc": { "type": "string", "format": "date-time" },
    "observed_monotonic_s": { "type": "number", "minimum": 0 },
    "observer_world_position": {
      "type": "array", "minItems": 2, "maxItems": 3,
      "items": { "type": "number" }
    },
    "observer_facing_rad": { "type": ["number", "null"], "minimum": -6.283185307179586, "maximum": 6.283185307179586 },
    "observer_facing_semantics": { "const": "VISIBLE_OR_DISPLACEMENT_ESTIMATE" },
    "track_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "reaction": { "enum": ["HOSTILE", "NEUTRAL", "FRIENDLY", "UNKNOWN"] },
    "center_x_normalized": { "type": "number", "minimum": -1, "maximum": 1 },
    "center_y_normalized": { "type": "number", "minimum": 0, "maximum": 1 },
    "width_normalized": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "height_normalized": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "position_uncertainty_normalized": { "type": "number", "minimum": 0, "maximum": 1 },
    "observation_count": { "type": "integer", "minimum": 2 },
    "source_key": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
    "experience_semantics": { "const": "APPEND_ONLY_OBSERVER_POSE_ENCOUNTER_MEMORY" },
    "entity_position_semantics": { "const": "UNKNOWN_NOT_INFERRED" },
    "entity_world_position": { "type": "null" },
    "execution_authority": { "const": false }
  }
}
