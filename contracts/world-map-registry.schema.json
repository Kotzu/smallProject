{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfect-assassin.local/contracts/world-map-registry.schema.json",
  "title": "TBC 2.4.3 WorldPack map registry v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "schema_version", "client_build", "maps", "execution_authority"],
  "properties": {
    "record_type": { "const": "tbc243_world_map_registry" },
    "schema_version": { "const": "1.0" },
    "client_build": { "const": "2.4.3.8606" },
    "client_world_inventory": { "type": ["string", "null"], "maxLength": 320 },
    "maps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["map_id", "internal_name", "runtime_profile", "execution_authority"],
        "properties": {
          "map_id": { "type": "integer", "minimum": 0, "maximum": 65535 },
          "internal_name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "runtime_profile": { "type": ["string", "null"], "maxLength": 260 },
          "semantic_catalog": { "type": ["string", "null"], "maxLength": 260 },
          "structure_index": { "type": ["string", "null"], "maxLength": 320 },
          "structure_access_graph": { "type": ["string", "null"], "maxLength": 320 },
          "execution_authority": { "const": false }
        }
      }
    },
    "execution_authority": { "const": false }
  }
}
