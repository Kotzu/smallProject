{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfect-assassin.local/contracts/lab-client-runtime-arm.schema.json",
  "title": "Perfect Assassin LAB client runtime arm v0.1",
  "type": "object",
  "required": [
    "record_type", "schema_version", "arm_nonce", "launch_receipt_nonce",
    "pid", "hwnd", "authorization_id", "authorization_sha256", "actor_binding",
    "target_profile", "client_build", "build_signature", "executable_path",
    "executable_sha256", "expected_realm_fingerprint", "realm_assurance",
    "realm_routing_sha256", "environment_scope",
    "realmlist_relative_path", "realmlist_sha256", "realmlist_directive",
    "server_kind", "decision_context", "allowed_actions", "issued_at",
    "expires_at", "scope", "execution_authority"
  ],
  "properties": {
    "record_type": { "const": "lab_client_runtime_arm" },
    "schema_version": { "const": "0.1" },
    "arm_nonce": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{8}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{12}$"
    },
    "launch_receipt_nonce": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{8}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{12}$"
    },
    "pid": { "type": "integer", "minimum": 1 },
    "hwnd": { "type": "string", "pattern": "^0x[A-F0-9]+$" },
    "authorization_id": { "type": "string", "minLength": 1 },
    "authorization_sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "actor_binding": { "$ref": "#/$defs/actorBinding" },
    "target_profile": { "const": "tbc_243_lab" },
    "client_build": { "type": "string", "minLength": 1 },
    "build_signature": { "type": "string", "minLength": 1 },
    "executable_path": { "type": "string", "minLength": 1 },
    "executable_sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "expected_realm_fingerprint": { "type": "string", "minLength": 1 },
    "realm_assurance": { "$ref": "#/$defs/realmAssurance" },
    "realm_routing_sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "realmlist_relative_path": { "type": "string", "minLength": 1 },
    "realmlist_sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "realmlist_directive": { "const": "set realmlist 127.0.0.1" },
    "environment_scope": { "const": "emulator_local" },
    "server_kind": { "const": "emulator" },
    "decision_context": { "const": "lab_clone" },
    "allowed_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "Login", "InspectAddons", "EnterWorld", "AcknowledgeLoginError", "AcknowledgeDisconnect", "ReleaseSpirit", "RetrieveCorpse", "ToggleEnemyNameplates", "OpenWorldMap",
          "CloseWorldMap", "SetDnd", "ClearTarget", "ToggleVideoRecording", "ReloadUi", "SetUiScale80", "SetUiScale100",
          "ApplyPredatorUiProfile", "RestorePredatorUiProfile", "SnapshotPredatorUiProfile",
          "RestoreUiScaleDefault", "ResizeWindowCompact",
          "ResizeWindowBaseline", "SaveShadowReplay", "DismissGameMenu", "Logout", "Close"
        ]
      }
    },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "scope": { "const": "lab_operator_bounded_input" },
    "execution_authority": { "const": true }
  },
  "$defs": {
    "actorBinding": {
      "type": "object",
      "required": ["schema_version", "instance_id", "actor_role", "actor_id", "decision_context", "memory_namespace", "expected_character_name", "credential_alias", "binding_assurance"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "instance_id": { "type": "string", "minLength": 1 },
        "actor_role": { "const": "lab_clone" },
        "actor_id": { "type": "string", "minLength": 1 },
        "decision_context": { "const": "lab_clone" },
        "memory_namespace": { "type": "string", "pattern": "^memory:lab:" },
        "expected_character_name": { "const": "Predator" },
        "credential_alias": { "const": "credential:lab:pa_observer" },
        "binding_assurance": {
          "type": "object",
          "required": ["state", "evidence_refs"],
          "properties": {
            "state": { "const": "configured_expected_only" },
            "evidence_refs": {
              "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 256 }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "realmAssurance": {
      "type": "object",
      "required": ["state", "method", "verified_at"],
      "properties": {
        "state": { "const": "local_process_config_revalidated_at_arm" },
        "method": { "const": "exact_realmlist_listener_process_config_and_realm_route" },
        "verified_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
