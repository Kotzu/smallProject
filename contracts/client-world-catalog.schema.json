{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfect-assassin.local/contracts/client-world-catalog.schema.json",
  "title": "Perfect Assassin client world catalog v1",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "tile": {
      "type": "object",
      "required": ["grid_x", "grid_y", "artifact", "sha256"],
      "properties": {
        "grid_x": { "type": "integer", "minimum": 0, "maximum": 63 },
        "grid_y": { "type": "integer", "minimum": 0, "maximum": 63 },
        "artifact": { "type": "string", "pattern": "^[0-9]{2}_[0-9]{2}[.]nav$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "road_semantic": {
      "type": "object",
      "required": ["grid_x", "grid_y", "artifact", "sha256"],
      "properties": {
        "grid_x": { "type": "integer", "minimum": 0, "maximum": 63 },
        "grid_y": { "type": "integer", "minimum": 0, "maximum": 63 },
        "artifact": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_ '-]{0,95}_[0-9]{2}_[0-9]{2}[.]road$"
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "map": {
      "type": "object",
      "required": [
        "map_id", "internal_name", "classification", "map_artifact",
        "map_artifact_sha256", "nav_tiles_sha256", "coverage_state",
        "interior_coverage", "road_semantic_coverage",
        "road_semantics_sha256", "tiles", "road_semantics"
      ],
      "properties": {
        "map_id": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "internal_name": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_ '-]{0,95}$" },
        "classification": {
          "enum": ["continent", "instance", "battleground", "arena", "transport", "other"]
        },
        "map_artifact": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_ '-]{0,95}[.]map$" },
        "map_artifact_sha256": { "$ref": "#/$defs/sha256" },
        "nav_tiles_sha256": { "$ref": "#/$defs/sha256" },
        "coverage_state": { "enum": ["partial", "complete"] },
        "interior_coverage": { "enum": ["none", "partial", "complete"] },
        "road_semantic_coverage": { "enum": ["partial", "complete"] },
        "road_semantics_sha256": { "$ref": "#/$defs/sha256" },
        "tiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/tile" }
        },
        "road_semantics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/road_semantic" }
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "record_type", "schema_version", "catalog_id", "target_profile",
    "product", "expansion", "client_version", "client_build",
    "asset_container", "asset_parser_profile", "world_catalog_asset",
    "world_catalog_asset_sha256", "nav_profile_id", "maps",
    "execution_authority"
  ],
  "properties": {
    "record_type": { "const": "client_world_catalog" },
    "schema_version": { "const": "1.0" },
    "catalog_id": { "$ref": "#/$defs/identifier" },
    "target_profile": { "$ref": "#/$defs/identifier" },
    "product": { "$ref": "#/$defs/identifier" },
    "expansion": { "$ref": "#/$defs/identifier" },
    "client_version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "client_build": { "type": "string", "minLength": 1, "maxLength": 32 },
    "asset_container": { "enum": ["mpq", "casc"] },
    "asset_parser_profile": { "$ref": "#/$defs/identifier" },
    "world_catalog_asset": { "type": "string", "minLength": 1, "maxLength": 256 },
    "world_catalog_asset_sha256": { "$ref": "#/$defs/sha256" },
    "nav_profile_id": { "$ref": "#/$defs/identifier" },
    "maps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/map" }
    },
    "execution_authority": { "const": false }
  },
  "additionalProperties": false
}
